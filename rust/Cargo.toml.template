[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
description = "{{description}}"
license = "MIT OR Apache-2.0"
repository = "https://github.com/WyattAu/{{project_name}}"
keywords = ["{{keyword1}}", "{{keyword2}}", "{{keyword3}}"]
categories = ["{{category}}"]

[dependencies]
thiserror = "2"
# Kit stack — uncomment as adopted (all resolve from crates.io):
# otelkit = "1"
# healthkit = "1"
# errcode = "0.1.0-alpha.2"   # pre-release; pin exact until 0.1 stable

[dev-dependencies]
criterion = { version = "0.8", features = ["html_reports"] }
proptest = "1"

[lints.rust]
unsafe_code = "forbid"
missing_docs = "deny"

[lints.clippy]
# Tier-c basics denied at the source, so local builds match CI (-D warnings)
# and the tier-a lints are already clean when the crate is promoted.
unwrap_used = "deny"
expect_used = "deny"
panic = "deny"
indexing_slicing = "deny"

[[bench]]
name = "benchmark"
harness = false

[profile.release]
lto = true
codegen-units = 1
strip = true
