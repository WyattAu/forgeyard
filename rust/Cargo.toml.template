[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.85"
description = "{{description}}"
license = "MIT OR Apache-2.0"
repository = "https://github.com/WyattAu/{{project_name}}"
keywords = ["{{keyword1}}", "{{keyword2}}", "{{keyword3}}"]
categories = ["{{category}}"]

[dependencies]
errcode = "0.1"
otelkit = "0.1"
healthkit = "0.1"

[dev-dependencies]
criterion = { version = "0.5", features = ["html_reports"] }
proptest = "1"
tokio = { version = "1", features = ["test-util", "macros"] }

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
unwrap_used = "deny"
panic = "deny"
expect_used = "warn"

[[bench]]
name = "benchmark"
harness = false

[profile.release]
lto = true
codegen-units = 1
strip = true
