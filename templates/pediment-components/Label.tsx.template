import { type JSX, splitProps } from "solid-js";

interface LabelProps extends JSX.LabelHTMLAttributes<HTMLLabelElement> {
  variant?: "default" | "required" | "optional";
}

export function Label(props: LabelProps) {
  const [local, others] = splitProps(props, ["variant", "class", "children"]);

  return (
    <label
      class={`py-label py-label-${local.variant ?? "default"} ${local.class ?? ""}`}
      {...others}
    >
      {local.children}
      {local.variant === "required" && <span class="py-label-required"> *</span>}
      {local.variant === "optional" && <span class="py-label-optional"> (optional)</span>}
    </label>
  );
}
